# Copy to .env.local and fill in real values. Never commit real secrets.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (MySQL / Hostinger) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# --- Auth / Sessions (Phase 3) ---
SESSION_SECRET=

# --- Razorpay (Phase 8) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp Notifications (AiSensy) ---
# API key from AiSensy dashboard: Manage > API Key
AISENSY_API_KEY=
# Each of these must match the exact "Campaign Name" of a Meta-approved,
# Live AiSensy API Campaign — create and approve the template in AiSensy
# first (Manage > Template Message), then wrap it in an API Campaign, then
# paste that campaign's name here. Leaving one blank disables sends for that
# category only (fails safely, logged to notification_log, never crashes).
AISENSY_CAMPAIGN_OTP=
AISENSY_CAMPAIGN_APPLICATION_CONFIRMATION=
AISENSY_CAMPAIGN_PAYMENT_CONFIRMATION=
AISENSY_CAMPAIGN_STATUS_UPDATE=
AISENSY_CAMPAIGN_DOCUMENT_QUERY=
AISENSY_CAMPAIGN_PAY_NOW_ACTIVATION=
AISENSY_CAMPAIGN_REMINDER=

# --- Email (nodemailer / SMTP) ---
# The same notifications sent on WhatsApp are also emailed to the applicant.
# Leave blank to disable email (WhatsApp is unaffected).
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465); leave blank/false for STARTTLS (587)
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to applicants, e.g. KDB Stall Portal <no-reply@your-domain>
SMTP_FROM=

# --- Public application flow ---
# 32-byte AES-256 key, base64-encoded: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AADHAAR_ENCRYPTION_KEY=
# Random secret used to sign application access tokens (interim ownership mechanism, pre-OTP)
APPLICATION_ACCESS_TOKEN_SECRET=
# Absolute path outside the web root in production; local-disk storage for uploaded documents
UPLOADS_DIR=./.uploads
